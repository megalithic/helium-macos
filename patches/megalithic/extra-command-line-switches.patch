+// Appends switches from `args` that `command_line` doesn't already have.
+// Non-switch arguments (such as URLs) are ignored.
+void AppendMissingSwitches(base::CommandLine* command_line,
+                           const std::vector<std::string>& args) {
+  if (args.empty()) {
+    return;
+  }
+
+  base::CommandLine::StringVector argv = {""};
+  argv.insert(argv.end(), args.begin(), args.end());
+  const base::CommandLine extra(argv);
+
+  // The DevTools port is bound to the default profile only: a launch with its
+  // own --user-data-dir or a pipe (e.g. automation tools) shouldn't open it.
+  const bool skip_debugging_port =
+      command_line->HasSwitch(switches::kUserDataDir) ||
+      command_line->HasSwitch(switches::kRemoteDebuggingPipe);
+
+  for (const auto& [name, value] : extra.GetSwitches()) {
+    if (command_line->HasSwitch(name)) {
+      continue;
+    }
+    if (skip_debugging_port && name == switches::kRemoteDebuggingPort) {
+      continue;
+    }
+    command_line->AppendSwitchNative(name, value);
+  }
+}
+
 }  // namespace
 
+void AppendExtraSwitchesFromEnvironmentAndDefaults(
+    base::CommandLine* command_line) {
+  if (command_line->HasSwitch(switches::kProcessType) ||
+      base::apple::IsBackgroundOnlyProcess()) {
+    return;
+  }
+
+  // GUI launches (Dock, Finder, open) don't inherit shell environment; use
+  // `launchctl setenv` for those, or prefer the user default below.
+  std::optional<std::string> env_flags =
+      base::Environment::Create()->GetVar("HELIUM_EXTRA_FLAGS");
+  if (env_flags) {
+    AppendMissingSwitches(
+        command_line,
+        base::SplitString(*env_flags, base::kWhitespaceASCII,
+                          base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY));
+  }
+
+  // Example:
+  //   defaults write net.imput.helium ExtraCommandLineSwitches -array
+  //   --remote-debugging-port=9223
+  @autoreleasepool {
+    NSArray<NSString*>* defaults_flags = [NSUserDefaults.standardUserDefaults
+        stringArrayForKey:@"ExtraCommandLineSwitches"];
+    std::vector<std::string> args;
+    for (NSString* flag in defaults_flags) {
+      args.push_back(base::SysNSStringToUTF8(flag));
+    }
+    AppendMissingSwitches(command_line, args);
+  }
+}
